# ==========================================
# TaskFlow Configuration
# ==========================================

# Database Connection (PostgreSQL with SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskflow_db

# JWT Security
SECRET_KEY=taskflow-super-secure-jwt-secret-key-at-least-64-characters-long-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Verification Code Expiration (Minutes)
VERIFICATION_CODE_EXPIRE_MINUTES=15
DEV_MODE=False

# Google / Gmail SMTP Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hossenmdrafayet@gmail.com
# Paste your 16-character Google App Password for "Mail" here:
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hossenmdrafayet@gmail.com
SMTP_FROM_NAME=TaskFlow
SMTP_USE_TLS=True
